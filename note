<?php
// Database configuration
$host     = 'localhost';
$db_name  = 'ogaawar1_votingdb';
$username = 'ogaawar1_ogaaward271user8'; // Default XAMPP/WAMP username
$password = 'g$urgetNu)Qf{VT=';     // Default XAMPP/WAMP password (usually empty)
$charset  = 'utf8mb4';

// Set DSN (Data Source Name)
$dsn = "mysql:host=$host;dbname=$db_name;charset=$charset";

// Options for error handling and fetch mode
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];

try {
    // Create the PDO instance
    $pdo = new PDO($dsn, $username, $password, $options);
    
    date_default_timezone_set('Africa/Lagos');
    $pdo->exec("SET time_zone = '+01:00'");
   
    // Un-comment the line below for testing connection success
    // echo "Connected successfully to student_reg_db";
   
} catch (PDOException $e) {
    // If connection fails, stop the script and show error
