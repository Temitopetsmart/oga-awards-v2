# =====================================================================

# OGA Awards: root .htaccess

# Works on cPanel (domain root) and on XAMPP (also inside a sub-folder such as htdocs/oga-awards-v2).

# ================================\*=====================================

# ---- 1. Never serve project internals, even if someone guesses the address ----

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(backend|database|docs|tests|tools|\.git|node_modules)(/|$) - [F,L]
</IfModule>
<FilesMatch "(^\.(?!well-known)|\.(sql|md|mjs|log|bak|ini|lock|example\.php)$|^(composer|package)(-lock)?\.json$)">
  Require all denied
</FilesMatch>

# ---- 2. Clean addresses: /vote instead of /vote.html, /admin/login instead of /admin/login.html ----

<IfModule mod_rewrite.c>
  # The redirects below read the address from the original request line (THE_REQUEST), so they work the same
  # at a domain root (cPanel) and inside a sub-folder (XAMPP htdocs/oga-awards-v2) with no RewriteBase to edit.
  # THE_REQUEST only holds what the visitor asked for, so our own internal rewrites can never loop.

# (a) /index and /admin/index (with or without .html) -> / and /admin/

RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)index(?:\.html)?(?:[\s?])
RewriteRule ^ %1 [R=301,L]

# (b) /anything.html -> /anything (permanent; a query string such as ?nominee=3 is kept)

RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s?]*)\.html(?:[\s?])
RewriteRule ^ %1 [R=301,L]

# (c) /vote/ -> /vote (a trailing slash on something that is not a folder)

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s?]+)/(?:[\s?])
RewriteRule ^ %1 [R=301,L]

# (d) /vote -> vote.html (served internally; the address bar keeps the clean address)

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---- 3. Safe browser defaults ----

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The gate scanner needs the camera on this site; nothing else is allowed.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  # Only sent over HTTPS (browsers ignore it on plain http). Remove if the site is not on HTTPS yet.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---- 4. Speed: compression and browser caching (this block stays on in production) ----

# Pages, scripts, styles and data files are sent compressed (about 70% smaller).

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# Browsers get a short "has this changed?" check for pages, scripts and styles: unchanged files come back as a tiny

# 304 and a new release goes live immediately. Pictures, icons and fonts are kept for 30 days.

# (Uploaded photos have their own rule in uploads/.htaccess.)

FileETag MTime Size
<IfModule mod_headers.c>

# Apache's compression adds "-gzip" to the ETag it sends, then fails to recognise it when the browser sends it

# back (so every revalidation would be a full download). Strip the suffix from the request.

RequestHeader edit "If-None-Match" "^\"(.*)-(gzip|br|deflate)\"$" "\"$1\""
  <FilesMatch "\.(html|js|css|json)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
