# ---- Always on (development and production) ----

# Never serve project internals, even if someone guesses the address.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(backend|database|docs|tests|\.git|node_modules)(/|$) - [F,L]
</IfModule>
<FilesMatch "(^\.(?!well-known)|\.(sql|md|mjs|log|bak|ini|lock|example\.php)$|^(composer|package)(-lock)?\.json$)">
  Require all denied
</FilesMatch>

# Safe browser defaults.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The gate scanner needs the camera on this site; nothing else is allowed.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  # Only sent over HTTPS (browsers ignore it on plain http). Remove if the site is not on HTTPS yet.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---- Development only: DELETE this block before going live (it stops browsers caching JS/CSS) ----
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>